generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id                   String       @id
  topic                String
  level                String
  statement            String
  code                 String?
  alternativesJson     String
  correctAlternativeId String
  explanation          String
  answers              ExamAnswer[]

  @@index([topic, level])
}

model ExamAttempt {
  id                   String       @id @default(cuid())
  userId               String?
  sessionId            String
  status               String       @default("in_progress")
  topic                String
  level                String
  questionIdsJson      String
  currentQuestionIndex Int          @default(0)
  score                Int          @default(0)
  enemYear             Int?
  startedAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  finishedAt           DateTime?
  answers              ExamAnswer[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model ExamAnswer {
  id                    String      @id @default(cuid())
  examId                String
  questionId            String
  selectedAlternativeId String
  correct               Boolean
  answeredAt            DateTime    @default(now())
  exam                  ExamAttempt @relation(fields: [examId], references: [id], onDelete: Cascade)
  question              Question    @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@index([examId])
}
