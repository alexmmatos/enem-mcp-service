{
  "name": "tech-exam-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Persistent interactive ENEM exams for MCP clients",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-with-ngrok.ts",
    "dev:local": "skybridge dev",
    "dev:tunnel": "tsx scripts/dev-with-ngrok.ts",
    "dev:alpic": "skybridge dev --tunnel",
    "build": "skybridge build",
    "start": "skybridge start",
    "deploy": "alpic deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "tsx scripts/ensure-sqlite.ts test.db && DATABASE_URL=file:./test.db prisma db push --skip-generate && DATABASE_URL=file:./test.db vitest run --no-file-parallelism",
    "test:watch": "DATABASE_URL=file:./test.db vitest",
    "db:generate": "prisma generate",
    "db:prepare": "tsx scripts/ensure-sqlite.ts dev.db",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "skybridge": "^1.3.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@skybridge/devtools": "^1.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "alpic": "^1.155.0",
    "eslint": "^9.39.5",
    "prisma": "^6.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
